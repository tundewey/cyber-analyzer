# Copy to .env and fill in values (never commit .env)

# --- Production container ---
# Set on AWS App Runner / ECS as environment variables
ENVIRONMENT=production

# --- LLM (use either OpenAI or OpenRouter) ---
# OPENAI_API_KEY=

# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=
# OPENROUTER_MAX_TOKENS=4096
# LLM_MAX_TOKENS=
# LLM_MODEL=

# --- Semgrep MCP ---
SEMGREP_APP_TOKEN=
